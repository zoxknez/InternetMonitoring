<Window x:Class="IEM.App.StopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zaustavljanje nadzora"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Page}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterOwner">

    <!--
        Three answers, each with a line saying what it does, because the question is asked once
        and the person answering it has two days of evidence behind them. A two-button message
        box would force "report or not" into a yes/no with no way back out, and no way to say
        what either answer costs.

        The theme is merged here as well as in App.xaml so the dialog stands on its own, and the
        two brushes on the Window tag are DynamicResource: attributes on the root element are
        assigned before this dictionary is merged, so StaticResource there is looked up in a
        scope that does not have the theme yet.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderFill}" Padding="22,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="#2C3A52" CornerRadius="9" Width="38" Height="38"
                        Margin="0,0,13,0" BorderBrush="#3E5070" BorderThickness="1">
                    <Path Style="{StaticResource Glyph}" Stroke="#8FB6E4" Width="17" Height="17"
                          Data="M 5,4 L 5,14 M 12,4 L 12,14" />
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Display}" FontSize="17"
                               Text="Zaustavljanje nadzora" />
                    <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="#9DAAC2"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22,18,22,6">
            <TextBlock x:Name="QuestionText" TextWrapping="Wrap" FontSize="14.5"
                       FontWeight="SemiBold" Foreground="{StaticResource Text}" />

            <TextBlock x:Name="ReassuranceText" TextWrapping="Wrap" Style="{StaticResource Hint}"
                       Margin="0,7,0,0" LineHeight="18" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="22,10,22,20">
            <Button x:Name="ReportButton" Style="{StaticResource Primary}"
                    HorizontalContentAlignment="Left" Padding="16,11" Click="OnReport"
                    IsDefault="True">
                <StackPanel>
                    <TextBlock x:Name="ReportLabel" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReportDetail" TextWrapping="Wrap" FontSize="11.5"
                               Opacity=".82" Margin="0,3,0,0" />
                </StackPanel>
            </Button>

            <Button x:Name="StopOnlyButton" Style="{StaticResource Secondary}"
                    HorizontalContentAlignment="Left" Padding="16,11" Margin="0,9,0,0"
                    Click="OnStopOnly">
                <StackPanel>
                    <TextBlock x:Name="StopOnlyLabel" FontWeight="SemiBold" />
                    <TextBlock x:Name="StopOnlyDetail" TextWrapping="Wrap" FontSize="11.5"
                               Opacity=".8" Margin="0,3,0,0" />
                </StackPanel>
            </Button>

            <Button x:Name="CancelButton" Style="{StaticResource Secondary}"
                    HorizontalContentAlignment="Left" Padding="16,11" Margin="0,9,0,0"
                    Click="OnCancel" IsCancel="True">
                <StackPanel>
                    <TextBlock x:Name="CancelLabel" FontWeight="SemiBold" />
                    <TextBlock x:Name="CancelDetail" TextWrapping="Wrap" FontSize="11.5"
                               Opacity=".8" Margin="0,3,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
