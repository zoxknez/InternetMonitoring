# Izlaz gradnje
bin/
obj/
publish/
TestResults/
*.binlog

# Objavljene arhive i objavljeni folderi. Namerno izvan git-a: tri stotine megabajta po
# izdanju nemaju šta da traže u istoriji koda. Gotove arhive idu u GitHub Releases.
artifacts/*
!artifacts/3.1-0/
# Acceptance records are evidence, not build output: they are the only durable
# proof a gate was actually run somewhere. The 3.1-6 reports had to be force-added
# past this rule; un-ignore the directory so the next one is not quietly dropped.
!artifacts/acceptance/

# Radna okruženja
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Zapisi i privremeni fajlovi
*.log
!tests/**/Fixtures/**/*.log
*.tmp

# Snimljene sesije, ako se slučajno naprave u kopiji repozitorijuma. Sadrže imena vaših mreža
# i adrese vaše opreme, i ne pripadaju ni jednom commit-u.
Sesija_*/
InternetEvidence/
Dokazi_Sesija_*.zip
MerenjeBrzine.json
merenje.json
merenje-u-toku.json
zahtev.json
DnevnikSlucaja.json

# Osim onih u baseline/ - to su izmišljeni fajlovi u obliku koji je pisala starija verzija,
# bez ijednog stvarnog podatka, i testovi ih čitaju. Pravilo iznad postoji da bi zaštitilo
# prave sesije, a ne da bi sprečilo da se u repozitorijum stavi fixture.
!baseline/**/MerenjeBrzine.json
!baseline/**/DnevnikSlucaja.json

# Vercel CLI: .vercel drži vezu ka projektu na tuđem nalogu, .env* tokene.
# Dodala ih je sama alatka pri povezivanju; ostaju, ali sa objašnjenjem.
.vercel
.env*
