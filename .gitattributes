# Line endings are normalised in the repository and checked out native, so a clone on Windows
# builds the same as a clone anywhere else. Without this the hash-chain tests would be at the
# mercy of whatever the contributor's editor happened to write.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.props     text
*.slnx      text
*.xaml      text
*.md        text
*.json      text
*.yml       text
*.editorconfig text

# Scripts that Windows runs. CRLF explicitly, because PowerShell in some hosts still trips
# over a lone LF in a here-string.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary and forensic payloads, so git neither diffs nor mangles them.
*.png       binary
*.pdf       binary
*.zip       binary
*.ttf       binary
*.ico       binary
*.db        binary
*.sig       binary
*.tsq       binary
*.tsr       binary
tests/**/Fixtures/** -text

# Everything Linux executes must be checked out LF, whatever the contributor's platform.
# A CRLF shebang makes dpkg fail the maintainer script with "bad interpreter", and the
# .deb would only break on the tester's machine, never on an LF-native CI runner.
*.sh        text eol=lf
*.py        text eol=lf
*.service   text eol=lf
*.desktop   text eol=lf
*.spec      text eol=lf
packaging/linux/debian/postinst     text eol=lf
packaging/linux/debian/prerm        text eol=lf
packaging/linux/debian/postrm       text eol=lf
packaging/linux/internet-evidence-monitor text eol=lf
