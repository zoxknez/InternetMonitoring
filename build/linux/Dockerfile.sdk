FROM ubuntu:24.04

ARG DOTNET_SDK_VERSION=10.0.111

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl libc6 libgcc-s1 libicu74 libssl3 libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --silent --show-error --location \
        https://dot.net/v1/dotnet-install.sh --output /tmp/dotnet-install.sh \
    && chmod 0755 /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --version "${DOTNET_SDK_VERSION}" --install-dir /opt/dotnet \
    && rm /tmp/dotnet-install.sh

ENV DOTNET_ROOT=/opt/dotnet
ENV PATH="/opt/dotnet:${PATH}"
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1
ENV DOTNET_NOLOGO=1

WORKDIR /src
