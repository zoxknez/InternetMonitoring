{
  "parityFixtureVersion": 1,
  "fixtureId": "parity.wifi.ssid-gone.asymmetric-scan",
  "scenario": "The adapter is down and the SSID is off air; Linux only has a partial scan",
  "intent": "Windows may identify WifiRadioDown; Linux remains at AdapterDown, while both retain LocalFault",
  "kind": "asymmetric-observability",
  "tags": ["wifi", "scan", "attribution"],
  "semanticInput": {
    "session": { "plannedDuration": "PT2M", "medium": "Wireless" },
    "ticks": [
      {
        "seq": 1,
        "monotonicMs": 0,
        "link": { "status": "Down", "hasGateway": false, "medium": "Wireless" },
        "world": {
          "gatewayReachable": { "t": "v", "v": false },
          "internetReachable": { "t": "v", "v": false },
          "radioSwitch": { "t": "v", "v": "on" },
          "ssidOnAir": { "t": "v", "v": false }
        }
      }
    ]
  },
  "platformFacts": {
    "windows": { "ticks": [ { "seq": 1, "radioOn": { "t": "v", "v": true }, "ssidVisibleInScan": { "t": "v", "v": false }, "scan": { "completeness": "Complete", "ageMs": 2000 }, "path": { "resolved": { "t": "v", "v": false } } } ] },
