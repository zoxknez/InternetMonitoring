  },
  "allowedDivergences": [
    { "path": "$.samples[0].networkState", "windows": "WifiRadioDown", "linux": "AdapterDown", "reason": "Linux partial scan cannot prove that the SSID is absent." },
    { "path": "$.incidents[0].worstState", "windows": "WifiRadioDown", "linux": "AdapterDown", "reason": "Incident attribution follows the deliberately weaker Linux sample." },
