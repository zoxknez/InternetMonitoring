<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Product>Monitor internet dokaza</Product>
    <Company>Monitor internet dokaza</Company>
    <Version>3.0.1-rc1</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.1.0</FileVersion>
    <NeutralLanguage>sr-Latn-RS</NeutralLanguage>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Locked restore is an explicit verification step rather than a condition on every release
    build, and that is forced by how publishing works: a self-contained publish pulls in
    Microsoft.NET.ILLink.Tasks, which an ordinary build does not reference. One lock file
    cannot satisfy both shapes, so making every Release build locked meant Release built
    fine and publish failed - which is the worse of the two to discover, since it only
    surfaces when you try to ship.

    So: versions are pinned centrally in Directory.Packages.props, the resolved graph is
    recorded in committed lock files, and the publish script verifies the lock is intact
    before it builds anything. That is the guarantee the report claims, without a build
    property that breaks the one operation the release depends on.
  -->
  <PropertyGroup Condition="'$(VerifyLockedDependencies)' == 'true'">
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!--
    Shared projects carry every supported release RID so their locked dependency graph and
    restore assets can be consumed by either desktop product. Platform entry points override
    this with their own two RIDs. PublishTrimmed stays false: WPF is not trim-compatible and
    the evidence path favours deterministic compatibility over a smaller package.
  -->
  <PropertyGroup>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>
